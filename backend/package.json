{
  "name": "nabz-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Nabz private messenger backend - Cloudflare Workers + D1 + Durable Objects",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate:local": "wrangler d1 migrations apply nabz-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply nabz-db --remote"
  },
  "dependencies": {
    "hono": "^4.6.14",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260915.1",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.24.0"
  },
  "allowScripts": {
    "esbuild@0.25.4": true,
    "esbuild@0.21.5": true,
    "esbuild@0.28.1": true
  }
}
